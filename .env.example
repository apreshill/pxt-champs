# Optional. A per-session way to give Pixeltable your API key.
# Copy this file to .env (gitignored) and fill it in, or just `export` the variable in your shell.
#
# The persistent way (recommended) is ~/.pixeltable/config.toml instead:
#   [pixeltable]
#   api_key = 'your-api-key'
# See https://docs.pixeltable.com/platform/configuration

PIXELTABLE_API_KEY=

# Only needed if you add a computed column that calls a provider (not used in the core notebooks).
# In the cloud, prefer setting these as Runtime Secrets on your database in the dashboard.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
